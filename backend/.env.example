# Copier en .env et remplir. Le .env n'est JAMAIS versionné.
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

SECRET_KEY=remplace-moi
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL. En local, la base et l'utilisateur se créent avec :
#   createdb -U postgres iqrago
DATABASE_URL=postgres://iqrago:CHANGE_MOI@127.0.0.1:5432/iqrago

REDIS_URL=redis://127.0.0.1:6379/0

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# Production seulement
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
